# Local Firebase Emulators. Copy to .env.local if it does not exist.
GCLOUD_PROJECT=demo-gdgoc-japan-hackathon-2026
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Browser-side Firebase Authentication (Google login only). Public values, not secrets.
# With the Auth Emulator, any API key string works.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gdgoc-japan-hackathon-2026.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gdgoc-japan-hackathon-2026
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Local lecture AI defaults to fixture. Set AI_MODE=vertex and the values below to use Vertex AI.
# AI_MODE=fixture
# GOOGLE_CLOUD_PROJECT=
# VERTEX_AI_LOCATION=
# GEMINI_MODEL=
